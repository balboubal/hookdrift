node_modules/
dist/
*.tsbuildinfo
.DS_Store

# Contracts are meant to be committed; last-run.json is not. It is transient
# output rewritten with a fresh timestamp by every `check`, so committing it
# means the working tree goes dirty just from running the tool.
**/.hookdrift/last-run.json

# Locally captured Stripe payloads. Real webhook captures can carry account
# details (the Stripe account email appears in account.updated events), so the
# capture output stays out of the repo - only the tooling is committed.
examples/stripe-live/fixtures*/
examples/stripe-live/pages/
examples/stripe-live/events*.json*
examples/stripe-live/.hookdrift/
examples/stripe-live/probe.json
examples/stripe-live/listen.log
examples/stripe-live/listener.pid

# GitHub's published webhook payload examples, fetched for validation. Public
# sample data, but third-party content - kept out of the repo, re-fetchable.
examples/github-live/fixtures*/
examples/github-live/.hookdrift/
