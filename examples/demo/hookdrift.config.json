{
  "contractsDir": ".hookdrift",
  "providers": {
    "stripe": {
      "fixtures": "{fixtures,fixtures-drifted}/stripe/**/*.json",
      "eventPath": "type"
    },
    "github": {
      "fixtures": "{fixtures,fixtures-drifted}/github/**/*.json",
      "eventPath": "@dirname"
    }
  },
  "source": ["src/**/*.ts"],
  "strict": false,
  "ignore": [
    {
      "path": "data.object.calculated_statement_descriptor",
      "kind": "new_field",
      "reason": "announced in Stripe's changelog, handler does not read it"
    }
  ]
}
